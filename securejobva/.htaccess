# Apache config, for a move to Apache or cPanel hosting. Nothing reads it today.
#
# The site is on Vercel, which reads vercel.json and never this file, and
# build.mjs does not copy it into dist/. It is kept so a move does not start
# from nothing: copy it by hand into public_html next to the contents of dist/.
#
# vercel.json is the source of truth. Everything below restates it for Apache,
# which gives none of it on its own — clean URLs, the host redirect, the
# response headers, the 404 page — so when one changes, change the other.
# The Cloudflare/Netlify copies (_headers, _redirects) were deleted rather than
# kept as a third list that nobody deployed and that had already drifted.

RewriteEngine On

# --- Canonical scheme and host ---------------------------------------------

# Force HTTPS.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Add www. build.mjs stamps https://www.securejobva.com into every canonical,
# og:url, hreflang and the sitemap, because that is the host Vercel serves and
# the apex redirects to it. This used to drop www instead, which would have
# made every one of those name an address that redirects — the split ranking
# signal the comment on SITE in build.mjs warns about. If SITE ever changes,
# this changes with it.
RewriteCond %{HTTP_HOST} ^securejobva\.com$ [NC]
RewriteRule ^ https://www.securejobva.com%{REQUEST_URI} [L,R=301]

# --- Path aliases -----------------------------------------------------------
# Short addresses worth printing on a card or an ad. Kept above the clean-URL
# rules because neither has a matching .html file to be caught by them.

RewriteRule ^apply/?$   /careers [L,R=301]
RewriteRule ^jobs/?$    /careers [L,R=301]

# --- Clean URLs -------------------------------------------------------------
# One canonical address per page: /careers, never /careers.html.
#
# Both redirects below test THE_REQUEST, which holds the browser's original
# request line, so they fire only on a real visit and never on the internal
# rewrite underneath them. Matching on REQUEST_URI instead would loop.

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [L,R=301]

# /careers.html -> /careers
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# /careers -> careers.html, served in place with no second round trip.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# --- Not found --------------------------------------------------------------
# The branded page build.mjs writes, as Vercel serves it from dist/404.html.

ErrorDocument 404 /404.html

# --- Response headers -------------------------------------------------------
# The same set, with the same values, as the headers block in vercel.json.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

  # includeSubDomains, and still no preload. Two years, which is what Vercel's
  # own redirects already send, so the host a visitor happens to hit first
  # does not decide how long the rule lasts. Preload is left out because it is
  # the part that cannot be walked back quickly: it is compiled into browsers.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains" env=HTTPS

  # Report-only: browsers log a violation in the console and block nothing.
  # These four directives restrict things no page here does — being framed by
  # another site, a <base> tag, a form posting off-site, a plugin — so they are
  # the part of a policy that can be switched to enforcing with no page
  # changes, once nothing has shown up for a while. Scripts and styles are not
  # covered: every page carries inline ones, and a policy for those is a
  # rewrite, not a header.
  Header always set Content-Security-Policy-Report-Only "frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # The signed-in pages say noindex in a meta tag too; this covers a crawler
  # that reads headers and not markup.
  <If "%{REQUEST_URI} =~ m#^/(admin|status|hub|seats|pay)(\.html)?$#">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# --- Caching ----------------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png       "access plus 30 days"
  ExpiresByType image/svg+xml   "access plus 30 days"

  # HTML must revalidate, or an edit you publish stays invisible to anyone who
  # has already visited.
  ExpiresByType text/html       "access plus 0 seconds"
</IfModule>

# --- Housekeeping -----------------------------------------------------------

Options -Indexes
